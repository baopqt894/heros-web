# Server only. Never add NEXT_PUBLIC_ to these keys.
# payOS credentials now belong to the HEROS backend .env.
HEROS_API_URL=http://127.0.0.1:2155/v1/
HEROS_CHECKOUT_ENABLED=false
HEROS_SITE_URL=http://127.0.0.1:3000
# Production: HEROS_SITE_URL=https://heros.dolphinxstudio.com
# Contact messages, accounts and orders are stored in backend MongoDB.
# Optional verified public links
HEROS_IOS_URL=
HEROS_ANDROID_URL=
HEROS_CONTACT_EMAIL=
# Optional server-only key (at least 32 random characters) for Google Sheets pull.
HEROS_FEEDBACK_EXPORT_KEY=
