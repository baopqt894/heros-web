# Server only. Never add NEXT_PUBLIC_ to these keys.
# payOS credentials now belong to the HEROS backend .env.
HEROS_API_URL=http://127.0.0.1:2155/v1/
HEROS_CHECKOUT_ENABLED=false
HEROS_SITE_URL=http://127.0.0.1:3000
# Local contact messages only; accounts/orders are stored in backend MongoDB.
HEROS_DB_PATH=.data/heros.sqlite
# Optional verified public links
HEROS_IOS_URL=
HEROS_ANDROID_URL=
HEROS_CONTACT_EMAIL=
